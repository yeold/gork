# Sample gork config for DOS and for the win32-legacy gork.exe.
# DOS and Windows 9x: put it beside GORK.EXE.
# Windows NT, 2000, XP and later: %USERPROFILE%\gork.cnf.
# If HOME is set, gork looks there instead.
#
# One `key = value` per line. A comment must be a line of its own: text
# after a value, `#` included, is part of the value.

# Where gork connects: a gork-relay on the network (the relay adds TLS).
relay = 192.168.1.10:8443

# On an IPX network without TCP/IP: the address gork-relay -x prints.
# relay = spx:0.525400A1B2C3:8443

# Your Anthropic key, unless the relay adds it.
api_key = sk-ant-REPLACE-ME

# model = claude-opus-5
# default_effort = high

# Extra directories the file tools may use, `;`-separated (up to 8).
# allow = d:/shared;c:/notes

# A slow machine or network may want a longer timeout.
# timeout = 300
# retries = 2
# stream = auto
