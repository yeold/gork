# DOS build with DJGPP, on DOS itself or with the cross compiler:
#   make -f Makefile.dj CC=i586-pc-msdosdjgpp-gcc PDCURSES=/path WATT=/path
# PDCURSES and WATT are the unpacked pdcurNNa.zip and watNNNNb.zip (net/watt)
# from DJGPP's v2tk directory.  gork.exe needs CWSDPMI.EXE beside it.
CC       = gcc
PDCURSES = /dev/env/DJGPP
WATT     = /dev/env/DJGPP/net/watt
CFLAGS   = -std=gnu89 -O2 -Wall -W

# mcp.c is left out: DOS cannot run MCP servers (see main.c).
gork.exe: main.c relay.c tui.c cJSON/cJSON.c
	$(CC) $(CFLAGS) -I$(PDCURSES)/include -I$(WATT)/inc -o $@ \
	    main.c relay.c tui.c cJSON/cJSON.c \
	    -L$(PDCURSES)/lib -L$(WATT)/lib -lpdcurses -lwatt -lm
