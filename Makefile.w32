# Windows build with MinGW (32-bit mingw-w64), on Windows or with the cross
# compiler:
#   make -f Makefile.w32 CC=i686-w64-mingw32-gcc PDCURSES=/path
# PDCURSES is the unpacked PDCurses source with wincon/pdcurses.a built in
# it (make -C wincon CC=...).  One gork.exe for Windows 9x and NT.
CC       = gcc
PDCURSES = ../PDCurses
# -march=i486: the compiler's default is the Pentium Pro, and Windows 9x
# runs on less.  For the same reason msvcrt's printf, not MinGW's own,
# which Debian ships compiled for the Pentium Pro (as its strtod: win.c).
CFLAGS   = -std=gnu89 -O2 -march=i486 -mtune=generic -Wall -W \
           -D__USE_MINGW_ANSI_STDIO=0

# mcp.c is left out: no fork, so no MCP servers (see main.c).  Winsock 1.1
# (wsock32) and a static libgcc, so that it needs no DLL but the system's.
# No runtime pseudo-relocations: win.c replaces the code that applies them.
LDFLAGS  = -Wl,--disable-runtime-pseudo-reloc
# winbuild.sh names the build: -DGORK_VERSION=\"...\" (version.sh)
DEFS     =
gork.exe: main.c relay.c tui.c win.c port.h cJSON/cJSON.c
	$(CC) $(CFLAGS) $(DEFS) $(LDFLAGS) -I$(PDCURSES) -o $@ \
	    main.c relay.c tui.c win.c cJSON/cJSON.c \
	    $(PDCURSES)/wincon/pdcurses.a -static-libgcc -lwsock32 -lm

# The same for Windows NT 3.1 and 3.5: linked against crtdll.dll, which
# they have (msvcrt.dll they have not, and a later one does not load
# there), and marked as a program for Windows 3.10, since they refuse one
# marked for 4.0.  PDCURSES_NT3 is a PDCurses built with -mcrtdll=crtdll.
NT3      = -mcrtdll=crtdll -Wl,--major-subsystem-version,3 \
           -Wl,--minor-subsystem-version,10 -Wl,--major-os-version,3 \
           -Wl,--minor-os-version,10
gorknt3.exe: main.c relay.c tui.c win.c nt3crt.c port.h cJSON/cJSON.c
	$(CC) $(NT3) $(CFLAGS) $(DEFS) $(LDFLAGS) -I$(PDCURSES_NT3) -o $@ \
	    main.c relay.c tui.c win.c nt3crt.c cJSON/cJSON.c \
	    $(PDCURSES_NT3)/wincon/pdcurses.a -static-libgcc -lwsock32 -lm
