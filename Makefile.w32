# Windows build with MinGW (32-bit mingw-w64), on Windows or with the cross
# compiler:
#   make -f Makefile.w32 CC=i686-w64-mingw32-gcc PDCURSES=/path
# PDCURSES is the unpacked PDCurses source with wincon/pdcurses.a built in
# it (make -C wincon CC=...).  One gork.exe for Windows 9x and NT.
CC       = gcc
PDCURSES = ../PDCurses
# -march=i486: the compiler's default is the Pentium Pro, and Windows 9x
# runs on less.  For the same reason msvcrt's printf, not MinGW's own,
# which Debian ships compiled for the Pentium Pro (as its strtod: win.c).
CFLAGS   = -std=gnu89 -O2 -march=i486 -mtune=generic -Wall -W \
           -D__USE_MINGW_ANSI_STDIO=0

# mcp.c is left out: no fork, so no MCP servers (see main.c).  Winsock 1.1
# (wsock32) and a static libgcc, so that it needs no DLL but the system's.
gork.exe: main.c relay.c tui.c win.c port.h cJSON/cJSON.c
	$(CC) $(CFLAGS) -I$(PDCURSES) -o $@ \
	    main.c relay.c tui.c win.c cJSON/cJSON.c \
	    $(PDCURSES)/wincon/pdcurses.a -static-libgcc -lwsock32 -lm
